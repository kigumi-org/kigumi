/// Explicit numeric conversions: no cast syntax, every conversion is a method.
/// A conversion that always fits returns the target type; one that can lose the value returns an Option.
/// usize / isize count as 64 bit here.
pub pure noalloc fn i8.toI16(self) -> i16

pub pure noalloc fn i8.toI32(self) -> i32
pub pure noalloc fn i8.toInt(self) -> i64
pub pure noalloc fn i8.toIsize(self) -> isize
pub pure noalloc fn i8.toU8(self) -> u8?
pub pure noalloc fn i8.toU16(self) -> u16?
pub pure noalloc fn i8.toU32(self) -> u32?
pub pure noalloc fn i8.toU64(self) -> u64?
pub pure noalloc fn i8.toUsize(self) -> usize?
pub pure noalloc fn i8.toFloat(self) -> Float
pub pure noalloc fn i8.toF32(self) -> f32

pub pure noalloc fn i16.toI8(self) -> i8?
pub pure noalloc fn i16.toI32(self) -> i32
pub pure noalloc fn i16.toInt(self) -> i64
pub pure noalloc fn i16.toIsize(self) -> isize
pub pure noalloc fn i16.toU8(self) -> u8?
pub pure noalloc fn i16.toU16(self) -> u16?
pub pure noalloc fn i16.toU32(self) -> u32?
pub pure noalloc fn i16.toU64(self) -> u64?
pub pure noalloc fn i16.toUsize(self) -> usize?
pub pure noalloc fn i16.toFloat(self) -> Float
pub pure noalloc fn i16.toF32(self) -> f32

