/// Truncates toward zero; None for NaN, an infinity or a value outside the Int range.
pub pure noalloc fn f64.toInt(self) -> Int?

pub pure noalloc fn f64.toF32(self) -> f32
pub pure noalloc fn f32.toInt(self) -> Int?
pub pure noalloc fn f32.toF64(self) -> Float

/// The Unicode scalar value of the character.
pub pure noalloc fn Char.toInt(self) -> Int

/// The character with this scalar value; None outside 0..0x10FFFF or inside the surrogate range.
pub pure noalloc fn Char.fromInt(value: Int) -> Char?

pub pure noalloc fn u8.toChar(self) -> Char
