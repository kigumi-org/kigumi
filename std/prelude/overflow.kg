// usize's width follows the target pointer width, so its MAX comes from
// wrapping arithmetic rather than a literal (same reason as isizeMaxValue).
pure fn usizeMaxValue() -> usize {
    let zero: usize = 0
    let one: usize = 1
    zero.wrappingSub(one)
}

