// isize's width follows the target pointer width (unlike the fixed-width
// int types above), so its MIN/MAX come from wrapping arithmetic on usize
// rather than a literal: a literal wide enough for 64 bit does not fit a
// 32 bit target's isize.
pure fn isizeMaxValue() -> isize {
    let zero: usize = 0
    let one: usize = 1
    let allOnes = zero.wrappingSub(one)
    allOnes.wrappingShiftRight(1).toIsize() || 0
}

pure fn isizeMinValue() -> isize {
    0 - isizeMaxValue() - 1
}

/// Sum and whether it overflowed isize's range.
pub pure fn isize.addWithOverflow(self, other: isize) -> Overflow[isize] {
    let wrapped = self.wrappingAdd(other)
    let ovf = (self >= 0 && other >= 0 && wrapped < 0) || (self < 0 && other < 0 && wrapped >= 0)
    Overflow {
        value: wrapped
        overflowed: ovf
    }
}

/// Difference and whether it overflowed isize's range.
pub pure fn isize.subWithOverflow(self, other: isize) -> Overflow[isize] {
    let wrapped = self.wrappingSub(other)
    let ovf = (self >= 0 && other < 0 && wrapped < 0) || (self < 0 && other >= 0 && wrapped >= 0)
    Overflow {
        value: wrapped
        overflowed: ovf
    }
}

/// Product and whether it overflowed isize's range.
pub pure fn isize.mulWithOverflow(self, other: isize) -> Overflow[isize] {
    if self == 0 || other == 0 {
        return Overflow {
            value: 0
            overflowed: false
        }
    }
    if other == -1 {
        let mn = isizeMinValue()
        if self == mn {
            return Overflow {
                value: mn
                overflowed: true
            }
        }
        return Overflow {
            value: self.wrappingMul(other)
            overflowed: false
        }
    }
    let wrapped = self.wrappingMul(other)
    Overflow {
        value: wrapped
        overflowed: wrapped / other != self
    }
}

/// Sum clamped to isize's range instead of overflowing.
pub pure fn isize.saturatingAdd(self, other: isize) -> isize {
    let r = self.addWithOverflow(other)
    if r.overflowed {
        if self >= 0 {
            isizeMaxValue()
        } else {
            isizeMinValue()
        }
    } else {
        r.value
    }
}

/// Difference clamped to isize's range instead of overflowing.
pub pure fn isize.saturatingSub(self, other: isize) -> isize {
    let r = self.subWithOverflow(other)
    if r.overflowed {
        if self >= 0 {
            isizeMaxValue()
        } else {
            isizeMinValue()
        }
    } else {
        r.value
    }
}

/// Product clamped to isize's range instead of overflowing.
pub pure fn isize.saturatingMul(self, other: isize) -> isize {
    let r = self.mulWithOverflow(other)
    if r.overflowed {
        if (self < 0 && other >= 0) || (self >= 0 && other < 0) {
            isizeMinValue()
        } else {
            isizeMaxValue()
        }
    } else {
        r.value
    }
}

