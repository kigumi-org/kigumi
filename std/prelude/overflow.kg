/// Sum and whether it overflowed the width; unlike `+`, never panics.
pub type Overflow[T] = {
    pub value T
    pub overflowed Bool
}

/// Sum and whether it overflowed i8's range.
pub pure fn i8.addWithOverflow(self, other: i8) -> Overflow[i8] {
    let wrapped = self.wrappingAdd(other)
    let ovf = (self >= 0 && other >= 0 && wrapped < 0) || (self < 0 && other < 0 && wrapped >= 0)
    Overflow {
        value: wrapped
        overflowed: ovf
    }
}

/// Difference and whether it overflowed i8's range.
pub pure fn i8.subWithOverflow(self, other: i8) -> Overflow[i8] {
    let wrapped = self.wrappingSub(other)
    let ovf = (self >= 0 && other < 0 && wrapped < 0) || (self < 0 && other >= 0 && wrapped >= 0)
    Overflow {
        value: wrapped
        overflowed: ovf
    }
}

/// Product and whether it overflowed i8's range.
pub pure fn i8.mulWithOverflow(self, other: i8) -> Overflow[i8] {
    if self == 0 || other == 0 {
        return Overflow {
            value: 0
            overflowed: false
        }
    }
    if other == -1 {
        if self == -128 {
            return Overflow {
                value: -128
                overflowed: true
            }
        }
        return Overflow {
            value: self.wrappingMul(other)
            overflowed: false
        }
    }
    let wrapped = self.wrappingMul(other)
    Overflow {
        value: wrapped
        overflowed: wrapped / other != self
    }
}

/// Sum clamped to i8's range instead of overflowing.
pub pure fn i8.saturatingAdd(self, other: i8) -> i8 {
    let r = self.addWithOverflow(other)
    if r.overflowed {
        if self >= 0 {
            127
        } else {
            -128
        }
    } else {
        r.value
    }
}

/// Difference clamped to i8's range instead of overflowing.
pub pure fn i8.saturatingSub(self, other: i8) -> i8 {
    let r = self.subWithOverflow(other)
    if r.overflowed {
        if self >= 0 {
            127
        } else {
            -128
        }
    } else {
        r.value
    }
}

/// Product clamped to i8's range instead of overflowing.
pub pure fn i8.saturatingMul(self, other: i8) -> i8 {
    let r = self.mulWithOverflow(other)
    if r.overflowed {
        if (self < 0 && other >= 0) || (self >= 0 && other < 0) {
            -128
        } else {
            127
        }
    } else {
        r.value
    }
}

