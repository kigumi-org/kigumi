/// Result of a three-way comparison.
pub type Ordering = Less | Equal | Greater

/// Equality; `==` and `!=` call `equals`. A record or ADT whose parts are
/// all `Eq` gets a generated `equals` unless it defines one.
pub interface Eq {
    pure fn equals(self, other: &Self) -> Bool
}

/// Hashing consistent with `Eq`; `Map` keys need both. A `Copy` record or
/// ADT whose parts are all `Hash` gets a generated `hash`.
pub interface Hash {
    pure fn hash(self) -> u64
}

/// Total order; `<`, `<=`, `>` and `>=` call `compareTo`.
pub interface Ord {
    pure fn compareTo(self, other: &Self) -> Ordering
}

/// Outcome of `Fallback.branch`: Hit carries the value, Miss what `||` passes to the fallback.
pub type Branch[V, R] = Hit(V) | Miss(R)

/// Anything a function can fail with; `?` and `fail` work on values of this interface.
pub interface Error {
    fn message(self) -> String
}

/// Types usable on the left of `||`: Bool, Option and Result.
pub interface Fallback[V, R] {
    pure noalloc fn branch(move self) -> Branch[V, R]
}

/// One value out of an `asm` block.
pub type Out[T] = {
    pub value T
}

/// `start..end`, half-open unless `inclusive` (`start..=end`).
pub type Range[T] = {
    pub start T
    pub end T
    pub inclusive Bool
}

/// Hit(true) for true, Miss(()) for false.
pub pure noalloc fn Bool.branch(move self) -> Branch[Bool, Unit]

/// Hit(value) for Some, Miss(()) for None.
pub pure noalloc fn Option[T].branch(move self) -> Branch[T, Unit]

/// Hit(value) for Ok, Miss(error) for Err.
pub pure noalloc fn Result[T, E].branch(move self) -> Branch[T, E]

/// The value of Some; panics on None.
pub pure fn Option[T].unwrap(move self) -> T {
    match self {
        Some(v) -> v
        None -> panic("unwrap on an empty value")
    }
}

/// The value of Some; panics with message on None.
pub pure fn Option[T].expect(move self, message: String) -> T {
    match self {
        Some(v) -> v
        None -> panic(message)
    }
}

/// Calls f with a borrow of the value; None when there is none.
pub pure fn Option[T].with[R](self, f: fn(&T) -> R) -> R? {
    match self {
        Some(v) -> Some(f(v))
        None -> None
    }
}

/// Transforms the value of Some by consuming it; None stays None.
pub pure fn Option[T].map[U](move self, f: fn(T) -> U) -> U? {
    match self {
        Some(v) -> Some(f(v))
        None -> None
    }
}

/// Chains an Option-returning step onto the value of Some, consuming it; None stays None.
pub pure fn Option[T].andThen[U](move self, f: fn(T) -> U?) -> U? {
    match self {
        Some(v) -> f(v)
        None -> None
    }
}

/// The value of Some, or fallback for None.
pub pure fn Option[T].unwrapOr(move self, fallback: T) -> T {
    match self {
        Some(v) -> v
        None -> fallback
    }
}

/// Moves the value out, leaving None in its place.
pub pure fn Option[T].take(mut self) -> T?

/// The value of Ok; panics on Err.
pub pure fn Result[T, E].unwrap(move self) -> T {
    match self {
        Ok(v) -> v
        Err(_) -> panic("unwrap on an empty value")
    }
}

/// The value of Ok; panics with message on Err.
pub pure fn Result[T, E].expect(move self, message: String) -> T {
    match self {
        Ok(v) -> v
        Err(_) -> panic(message)
    }
}

/// Transforms the value of Ok by consuming it; Err stays Err.
pub pure fn Result[T, E].map[U](move self, f: fn(T) -> U) -> Result[U, E] {
    match self {
        Ok(v) -> Ok(f(v))
        Err(e) -> Err(e)
    }
}

/// Transforms the error of Err by consuming it; Ok stays Ok.
pub pure fn Result[T, E].mapErr[F](move self, f: fn(E) -> F) -> Result[T, F] {
    match self {
        Ok(v) -> Ok(v)
        Err(e) -> Err(f(e))
    }
}

/// Chains a Result-returning step onto the value of Ok, consuming it; Err stays Err.
pub pure fn Result[T, E].andThen[U](move self, f: fn(T) -> Result[U, E]) -> Result[U, E] {
    match self {
        Ok(v) -> f(v)
        Err(e) -> Err(e)
    }
}

/// A readable rendering of any value, for diagnostics; not a stable format.
pub pure fn debug[T](value: &T) -> String

