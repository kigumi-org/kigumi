/// Length in bytes.
pub pure noalloc fn String.len(self) -> usize

/// Whether the string has no bytes.
pub pure noalloc fn String.isEmpty(self) -> Bool {
    self.len() == 0
}

/// The UTF-8 bytes of the string.
pub pure noalloc fn String.bytes(self) -> Bytes

/// The Unicode scalar values of the string, in order.
pub pure fn String.chars(self) -> Array[Char] {
    let mut out = Array.empty[Char]()
    let n = self.len()
    let mut i: usize = 0
    for i < n {
        let lead = self[i].toInt()
        let mut width = 1
        let mut point = lead
        if lead >= 240 {
            width = 4
            point = lead & 7
        } else if lead >= 224 {
            width = 3
            point = lead & 15
        } else if lead >= 192 {
            width = 2
            point = lead & 31
        }
        let mut k = 1
        for k < width {
            point = (point << 6) | (self[i + (k.toUsize() || 0)].toInt() & 63)
            k = k + 1
        }
        out.push(Char.fromInt(point) || '?')
        i = i + (width.toUsize() || 0)
    }
    out
}

/// Whether sub occurs in the string; the empty string occurs in every string.
pub pure noalloc fn String.contains(self, sub: String) -> Bool {
    if sub.len() > self.len() {
        return false
    }
    let mut i: usize = 0
    for i <= self.len() - sub.len() {
        if self.matchesAt(sub, i) {
            return true
        }
        i = i + 1
    }
    false
}

/// Whether the bytes of sub appear at byte offset at; false for any offset past the end.
pub pure noalloc fn String.matchesAt(self, sub: String, at: usize) -> Bool {
    if sub.len() > self.len() || at > self.len() - sub.len() {
        return false
    }
    let mut j: usize = 0
    for j < sub.len() {
        if self[at + j] != sub[j] {
            return false
        }
        j = j + 1
    }
    true
}

/// Whether the string begins with prefix.
pub pure noalloc fn String.startsWith(self, prefix: String) -> Bool {
    self.matchesAt(prefix, 0)
}

/// Whether the string ends with suffix.
pub pure noalloc fn String.endsWith(self, suffix: String) -> Bool {
    suffix.len() <= self.len() && self.matchesAt(suffix, self.len() - suffix.len())
}

/// Bytes start..end of the string; None unless both offsets are within it and on character boundaries.
pub pure fn String.sliceBytes(self, start: usize, end: usize) -> String?

/// Whether b is an ASCII space, tab, carriage return or newline.
pure noalloc fn isAsciiSpace(b: u8) -> Bool {
    b == 32 || b == 9 || b == 13 || b == 10
}

/// Copy without leading and trailing ASCII whitespace (space, tab, CR, LF).
pub pure fn String.trim(self) -> String {
    let mut lo: usize = 0
    let mut hi = self.len()
    for lo < hi && isAsciiSpace(self[lo]) {
        lo = lo + 1
    }
    for hi > lo && isAsciiSpace(self[hi - 1]) {
        hi = hi - 1
    }
    self.sliceBytes(lo, hi) || ""
}

/// Pieces between occurrences of sep, empty pieces included; an empty sep yields the whole string as one piece.
pub pure fn String.split(self, sep: String) -> Array[String] {
    let mut out = Array.empty[String]()
    if sep.len() == 0 {
        out.push(self)
        return out
    }
    let mut start: usize = 0
    let mut i: usize = 0
    for i + sep.len() <= self.len() {
        if self.matchesAt(sep, i) {
            out.push(self.sliceBytes(start, i) || "")
            i = i + sep.len()
            start = i
        } else {
            i = i + 1
        }
    }
    out.push(self.sliceBytes(start, self.len()) || "")
    out
}

/// self followed by other.
pub pure fn String.concat(self, other: String) -> String {
    "${self}${other}"
}

/// Copy with ASCII letters upper-cased; other bytes are kept.
pub pure fn String.toUpper(self) -> String {
    self.shiftAscii(97, 122, false)
}

/// Copy with ASCII letters lower-cased; other bytes are kept.
pub pure fn String.toLower(self) -> String {
    self.shiftAscii(65, 90, true)
}

/// Copy with every byte in lo..=hi moved 32 places down (upper case) or up (lower case); the
/// callers keep lo..=hi inside the ASCII letters, so the shifted byte stays a valid UTF-8 unit.
pure fn String.shiftAscii(self, lo: u8, hi: u8, down: Bool) -> String {
    let mut bytes = Array.empty[u8]()
    let mut i: usize = 0
    for i < self.len() {
        let b = self[i]
        if b >= lo && b <= hi {
            if down {
                bytes.push(b + 32)
            } else {
                bytes.push(b - 32)
            }
        } else {
            bytes.push(b)
        }
        i = i + 1
    }
    String.fromBytes(Bytes.fromArray(&bytes)) || self
}

/// The string repeated count times.
pub pure fn String.repeat(self, count: usize) -> String {
    // Doubling keeps the copying linear in the result instead of quadratic.
    let mut out = ""
    let mut base = self
    let mut left = count
    for left > 0 {
        if left % 2 == 1 {
            out = "${out}${base}"
        }
        left = left / 2
        if left > 0 {
            base = "${base}${base}"
        }
    }
    out
}

/// Why an allocation was refused; carries no allocation itself.
pub type AllocError = | OutOfMemory

/// Bytes holding the items in order.
pub pure fn Bytes.fromArray(items: &Array[u8]) -> Bytes

/// Bytes holding the items in order, or AllocError when the allocator
/// refuses (fromArray panics instead).
pub pure fn Bytes.tryFromArray(items: &Array[u8]) -> Result[Bytes, AllocError]

/// The UTF-8 bytes of the string.
pub pure noalloc fn String.toBytes(self) -> Bytes

/// Interprets bytes as UTF-8; fails when they are not valid UTF-8.
pub pure fn String.fromBytes(bytes: Bytes) -> String!

/// Interprets bytes as UTF-8, same as fromBytes, but reports an allocator
/// refusal as an error too instead of risking the crash fromBytes has there.
pub pure fn String.tryFromBytes(bytes: Bytes) -> String!

/// Byte-wise equality; satisfies `Eq`.
pub pure noalloc fn String.equals(self, other: &String) -> Bool

/// The hash of any `Hash` value; lets generic code hash a `T: Hash`.
pub pure fn hash[T: Hash](value: &T) -> u64 {
    value.hash()
}

/// Hash of the bytes; satisfies `Hash`.
pub pure noalloc fn String.hash(self) -> u64

/// Byte-wise lexicographic comparison.
pub pure noalloc fn String.compareTo(self, other: &String) -> Ordering

/// Number of bytes.
pub pure noalloc fn Bytes.len(self) -> usize

/// Byte at index, or None past the end.
pub pure noalloc fn Bytes.get(self, index: usize) -> u8?

/// Bytes start..end of self; None unless start <= end <= self.len().
pub pure fn Bytes.slice(self, start: usize, end: usize) -> Bytes?

/// Byte-wise position of the first occurrence of sub in self; the empty sub matches at 0.
pub pure noalloc fn Bytes.indexOf(self, sub: Bytes) -> usize? {
    if sub.len() > self.len() {
        return None
    }
    let mut i: usize = 0
    for i <= self.len() - sub.len() {
        if self.matchesAt(sub, i) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

/// Whether the bytes of sub appear at byte offset at; false for any offset past the end.
pub pure noalloc fn Bytes.matchesAt(self, sub: Bytes, at: usize) -> Bool {
    if sub.len() > self.len() || at > self.len() - sub.len() {
        return false
    }
    let mut j: usize = 0
    for j < sub.len() {
        if self[at + j] != sub[j] {
            return false
        }
        j = j + 1
    }
    true
}

/// Whether self begins with sub.
pub pure noalloc fn Bytes.startsWith(self, sub: Bytes) -> Bool {
    self.matchesAt(sub, 0)
}

/// Whether self ends with sub.
pub pure noalloc fn Bytes.endsWith(self, sub: Bytes) -> Bool {
    sub.len() <= self.len() && self.matchesAt(sub, self.len() - sub.len())
}

/// Whether sub occurs in self; the empty sub occurs in every Bytes.
pub pure noalloc fn Bytes.contains(self, sub: Bytes) -> Bool {
    self.indexOf(sub) is Some(_)
}

/// n zero bytes.
pub pure fn Bytes.zeros(n: usize) -> Bytes

/// n bytes, each set to value.
pub pure fn Bytes.fill(value: u8, n: usize) -> Bytes

/// The bytes of self followed by those of other.
pub pure fn Bytes.concat(self, other: Bytes) -> Bytes

/// self followed by other, or AllocError when the allocator refuses (concat panics instead).
pub pure fn Bytes.tryConcat(self, other: Bytes) -> Result[Bytes, AllocError]

