    let v1 = B.fromJson(items.takeAt(0) || Value.Null)?
    let v2 = C.fromJson(items.takeAt(0) || Value.Null)?
    let v3 = D.fromJson(items.takeAt(0) || Value.Null)?
    let v4 = E.fromJson(items.takeAt(0) || Value.Null)?
    let v5 = F.fromJson(items.takeAt(0) || Value.Null)?
    Ok((v0, v1, v2, v3, v4, v5))
}

pub fn Tuple7[A: Encode, B: Encode, C: Encode, D: Encode, E: Encode, F: Encode, G: Encode].toJson(self) -> Value {
    Value.List(Array.of(self._0.toJson(), self._1.toJson(), self._2.toJson(), self._3.toJson(), self._4.toJson(), self._5.toJson(), self._6.toJson()))
}

pub fn Tuple7[A: Decode, B: Decode, C: Decode, D: Decode, E: Decode, F: Decode, G: Decode].fromJson(value: Value) -> Tuple7[A, B, C, D, E, F, G]! {
    let mut items = tupleItems(value, 7)?
    let v0 = A.fromJson(items.takeAt(0) || Value.Null)?
    let v1 = B.fromJson(items.takeAt(0) || Value.Null)?
    let v2 = C.fromJson(items.takeAt(0) || Value.Null)?
    let v3 = D.fromJson(items.takeAt(0) || Value.Null)?
    let v4 = E.fromJson(items.takeAt(0) || Value.Null)?
    let v5 = F.fromJson(items.takeAt(0) || Value.Null)?
    let v6 = G.fromJson(items.takeAt(0) || Value.Null)?
    Ok((v0, v1, v2, v3, v4, v5, v6))
}

pub fn Tuple8[A: Encode, B: Encode, C: Encode, D: Encode, E: Encode, F: Encode, G: Encode, H: Encode].toJson(self) -> Value {
    Value.List(Array.of(self._0.toJson(), self._1.toJson(), self._2.toJson(), self._3.toJson(), self._4.toJson(), self._5.toJson(), self._6.toJson(), self._7.toJson()))
}

pub fn Tuple8[A: Decode, B: Decode, C: Decode, D: Decode, E: Decode, F: Decode, G: Decode, H: Decode].fromJson(value: Value) -> Tuple8[A, B, C, D, E, F, G, H]! {
    let mut items = tupleItems(value, 8)?
    let v0 = A.fromJson(items.takeAt(0) || Value.Null)?
    let v1 = B.fromJson(items.takeAt(0) || Value.Null)?
    let v2 = C.fromJson(items.takeAt(0) || Value.Null)?
    let v3 = D.fromJson(items.takeAt(0) || Value.Null)?
    let v4 = E.fromJson(items.takeAt(0) || Value.Null)?
    let v5 = F.fromJson(items.takeAt(0) || Value.Null)?
    let v6 = G.fromJson(items.takeAt(0) || Value.Null)?
    let v7 = H.fromJson(items.takeAt(0) || Value.Null)?
    Ok((v0, v1, v2, v3, v4, v5, v6, v7))
}
