import map from std/map
import text from std/text

/// A byte cursor over the input; depth guards against a document nested deeper than a stack can take.
type Cursor = {
    pub bytes Bytes
    mut pos usize
    mut depth Int
}

const maxDepth = 5000

/// Parses JSON text (RFC 8259) into a Value; any deviation fails with "invalid JSON".
pub fn parse(source: String) -> Value! {
    let mut c = Cursor {
        bytes: source.bytes()
        pos: 0
        depth: 0
    }
    let v = c.value()?
    c.skipSpace()
    if c.pos != c.bytes.len() {
        fail invalid()
    }
    Ok(v)
}

fn invalid() -> Error {
    Error { text: "invalid JSON" }
}

/// The input between two byte offsets as text.
fn Cursor.text(self, start: usize, end: usize) -> String {
    let mut out = Array.empty[u8]()
    for i in start..end {
        out.push(self.bytes.get(i) || 0)
    }
    String.fromBytes(Bytes.fromArray(&out)) || ""
}

fn Cursor.peek(self) -> Int {
    if self.pos < self.bytes.len() {
        (self.bytes.get(self.pos) || 0).toInt()
    } else {
        -1
    }
}

fn Cursor.skipSpace(mut self) -> Unit {
    for {
        let b = self.peek()
        if b == 32 || b == 9 || b == 10 || b == 13 {
            self.pos = self.pos + 1
        } else {
            break
        }
    }
}

fn Cursor.eat(mut self, word: String) -> Bool {
    let n = word.len()
    if self.bytes.len() < self.pos + n {
        return false
    }
    if self.text(self.pos, self.pos + n) == word {
        self.pos = self.pos + n
        return true
    }
    false
}

fn Cursor.value(mut self) -> Value! {
    self.depth = self.depth + 1
    if self.depth > maxDepth {
        fail invalid()
    }
    self.skipSpace()
    let b = self.peek()
    let out = if b == 110 && self.eat("null") {
        Ok(Value.Null)
    } else if b == 116 && self.eat("true") {
        Ok(Value.Boolean(true))
    } else if b == 102 && self.eat("false") {
        Ok(Value.Boolean(false))
    } else if b == 34 {
        Ok(Value.Text(self.string()?))
    } else if b == 91 {
        self.list()
    } else if b == 123 {
        self.object()
    } else {
        self.number()
    }
    self.depth = self.depth - 1
    out
}

fn Cursor.list(mut self) -> Value! {
    self.pos = self.pos + 1
    let mut items = Array.empty[Value]()
    self.skipSpace()
    if self.peek() == 93 {
        self.pos = self.pos + 1
        return Ok(Value.List(items))
    }
    for {
        items.push(self.value()?)
        self.skipSpace()
        let b = self.peek()
        self.pos = self.pos + 1
        if b == 93 {
            break
        }
        if b != 44 {
            fail invalid()
        }
    }
    Ok(Value.List(items))
}

fn Cursor.object(mut self) -> Value! {
    self.pos = self.pos + 1
    let mut fields = map.empty[String, Value]()
    self.skipSpace()
    if self.peek() == 125 {
        self.pos = self.pos + 1
        return Ok(Value.Object(fields))
    }
    for {
        self.skipSpace()
        if self.peek() != 34 {
            fail invalid()
        }
        let key = self.string()?
        self.skipSpace()
        if self.peek() != 58 {
            fail invalid()
        }
        self.pos = self.pos + 1
        fields.set(key, self.value()?)
        self.skipSpace()
        let b = self.peek()
        self.pos = self.pos + 1
        if b == 125 {
            break
        }
        if b != 44 {
            fail invalid()
        }
    }
    Ok(Value.Object(fields))
}

fn Cursor.digits(mut self) -> Int {
    let mut count = 0
    for self.peek() >= 48 && self.peek() <= 57 {
        self.pos = self.pos + 1
        count = count + 1
    }
    count
}

fn Cursor.number(mut self) -> Value! {
    let start = self.pos
    let mut negative = false
    if self.peek() == 45 {
        negative = true
        self.pos = self.pos + 1
    }
    let digitsStart = self.pos
    let mut integral = true
    if self.peek() == 48 {
        self.pos = self.pos + 1
    } else if self.digits() == 0 {
        fail invalid()
    }
    if self.peek() == 46 {
        integral = false
        self.pos = self.pos + 1
        if self.digits() == 0 {
            fail invalid()
        }
    }
    if self.peek() == 101 || self.peek() == 69 {
        integral = false
        self.pos = self.pos + 1
        if self.peek() == 43 || self.peek() == 45 {
            self.pos = self.pos + 1
        }
        if self.digits() == 0 {
            fail invalid()
        }
    }
    let literal = self.text(start, self.pos)
    if integral {
        if text.parseInt(literal) is Some(n) {
            return Ok(Value.Integer(n))
        }
        if negative {
            fail invalid()
        }
        let digits = self.text(digitsStart, self.pos)
        if text.parseUint(digits) is Some(u) {
            return Ok(Value.Unsigned(u))
        }
        fail Error { text: "integer literal ${digits} is out of range for u64 (max 18446744073709551615)" }
    }
    if text.parseFloat(literal) is Some(f) {
        return Ok(Value.Number(f))
    }
    fail invalid()
}
