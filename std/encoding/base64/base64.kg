import text from std/text

/// Base64 (RFC 4648). `encode` / `decode` use the standard alphabet with
/// padding, as HTTP Basic credentials and PEM bodies do. `encodeUrl` /
/// `decodeUrl` use the URL and filename safe alphabet without padding, as JWT
/// does. Both decoders accept their own alphabet with or without padding.
const stdAlphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

const urlAlphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

pub type DecodeError = {
    pub text String
}

pub fn DecodeError.message(self) -> String {
    self.text
}

/// Standard alphabet, padded with '='.
pub pure fn encode(data: Bytes) -> String {
    render(data, stdAlphabet, true)
}

/// URL and filename safe alphabet, unpadded.
pub pure fn encodeUrl(data: Bytes) -> String {
    render(data, urlAlphabet, false)
}

/// Bytes of a standard-alphabet string; padding is optional.
pub pure fn decode(text: String) -> Result[Bytes, DecodeError] {
    parse(text, stdAlphabet)
}

/// Bytes of a URL-safe string; padding is optional.
pub pure fn decodeUrl(text: String) -> Result[Bytes, DecodeError] {
    parse(text, urlAlphabet)
}

pure fn render(data: Bytes, alphabet: String, pad: Bool) -> String {
    let a = alphabet.bytes()
    let mut out = Array.empty[u8]()
    let n = data.len()
    let mut i: usize = 0
    for i + 3 <= n {
        let w = (data[i].toUsize() << 16) | (data[i + 1].toUsize() << 8) | data[i + 2].toUsize()
        out.push(a[(w >> 18) & 63])
        out.push(a[(w >> 12) & 63])
        out.push(a[(w >> 6) & 63])
        out.push(a[w & 63])
        i = i + 3
    }
    let left = n - i
    if left == 1 {
        let w = data[i].toUsize() << 16
        out.push(a[(w >> 18) & 63])
        out.push(a[(w >> 12) & 63])
        if pad {
            out.push(61)
            out.push(61)
        }
    } else if left == 2 {
        let w = (data[i].toUsize() << 16) | (data[i + 1].toUsize() << 8)
        out.push(a[(w >> 18) & 63])
        out.push(a[(w >> 12) & 63])
        out.push(a[(w >> 6) & 63])
        if pad {
            out.push(61)
        }
    }
    String.fromBytes(Bytes.fromArray(&out)) || ""
}

pure fn parse(text: String, alphabet: String) -> Result[Bytes, DecodeError] {
    let src = text.toBytes()
    // Trailing '=' only says how many bytes the last group carries; the group
    // length below already encodes that, so drop the padding first.
    let mut end = src.len()
    for end > 0 && src[end - 1] == 61 {
        end = end - 1
    }
    if end % 4 == 1 {
        fail DecodeError { text: "base64: length ${end} leaves a single stray character" }
    }
    let mut out = Array.empty[u8]()
    let mut i: usize = 0
    for i < end {
        let take = if end - i >= 4 {
            4
        } else {
            end - i
        }
        let mut w: usize = 0
        let mut k: usize = 0
        for k < 4 {
            let sextet = if k < take {
                value(src[i + k], alphabet)?
            } else {
                0
            }
            w = (w << 6) | sextet
            k = k + 1
        }
        out.push(((w >> 16) & 255).toU8() || 0)
        if take >= 3 {
            out.push(((w >> 8) & 255).toU8() || 0)
        }
        if take == 4 {
            out.push((w & 255).toU8() || 0)
        }
        i = i + take
    }
    Bytes.fromArray(&out)
}

pure fn value(c: u8, alphabet: String) -> Result[usize, DecodeError] {
    let a = alphabet.bytes()
    let mut i: usize = 0
    for i < 64 {
        if a[i] == c {
            return Ok(i)
        }
        i = i + 1
    }
    fail DecodeError { text: "base64: `${text.fromChar(c.toChar())}` is not in the alphabet" }
}
