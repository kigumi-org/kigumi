-- lib/recv.kg --
type Buf = {
    pub mut n Int
}

fn Buf.push(mut self) -> Unit {
    self.n += 1
}

fn Buf.take(move self) -> Int {
    self.n
}

fn Buf.peek(self) -> Int {
    self.n
}

fn Buf.make() -> Buf {
    Buf { n: 0 }
}

type Res = resource {
    pub fd Int
}

fn Res.drop(move self) -> Unit {}

fn Res.id(self) -> Int {
    self.fd
}

fn use(b: Buf, mut m: Buf, r: &Buf, w: &mut Buf, res: Res) -> Unit {
    b.push() //~ ERROR `push` takes `mut self` but `b` is immutable
    m.push()
    r.push() //~ ERROR `push` takes `mut self` but `r` is immutable
    w.push()
    let t = b.take() //~ TYPE t : Int
    let u = r.take() //~ ERROR cannot move `Buf` out of a borrow
    let p = r.peek() //~ TYPE p : Int
    let q = Buf.make().take() //~ TYPE q : Int
    let v = b.peek //~ TYPE v : fn() -> Int
    let z = v() //~ TYPE z : Int
    let id = res.id //~ ERROR cannot form a method value on move-only `Res`
    let lam = () => res.id()
    let n = b.n
    b.n = 1 //~ ERROR `b` is immutable
    m.n = 1
    w.n = 2
    r.n = 3 //~ ERROR `r` is immutable
}

type Outer = {
    mut inner Buf
}

type Frozen = {
    inner Buf
}

fn Outer.make() -> Outer {
    Outer { inner: Buf { n: 0 } }
}

fn useField(o: Outer, mut f: Frozen) -> Unit {
    let lb = Buf.make()
    lb.push() //~ ERROR `push` takes `mut self` but `lb` is immutable
    let lo = Outer.make()
    lo.inner.push() //~ ERROR `push` takes `mut self` but `lo.inner` is immutable
    o.inner.push() //~ ERROR `push` takes `mut self` but `o.inner` is immutable
    f.inner.push() //~ ERROR `push` takes `mut self` but `f.inner` is immutable
    let fz = Frozen { inner: Buf { n: 0 } }
    fz.inner.push() //~ ERROR `push` takes `mut self` but `fz.inner` is immutable
}
