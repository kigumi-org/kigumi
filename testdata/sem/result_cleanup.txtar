-- lib/cl.kg --
import fs from std/fs

fn write(files: fs.Files, path: fs.Path) -> Unit! {
    let mut f = files.create(path)?
    errdefer _ = files.remove(path)
    defer _ = files.remove(path)
    defer {
        _ = files.remove(path)
    }
    _ = f.write("x".toBytes())?
    f.close()?
}

fn bad(files: fs.Files, path: fs.Path) -> Unit! {
    defer files.remove(path)? //~ ERROR `?` is not allowed in a cleanup body
    defer files.remove(path) //~ ERROR unused `Unit!`
    defer return //~ ERROR `return` is not allowed in a cleanup body
    errdefer fail Empty //~ ERROR `fail` is not allowed in a cleanup body //~ ERROR undefined name `Empty`
    for i in 0..3 {
        defer break //~ ERROR `break` is not allowed in a cleanup body
    }
}

fn noFail() -> Unit {
    errdefer _ = 1 //~ ERROR `errdefer` in a function that cannot fail
}
