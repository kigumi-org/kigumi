-- lib/rec.kg --
pub type User = {
    pub id Int
    pub name String
    pub nick String?
}

type Summary = {
    pub id Int
    pub name String
}

type Big = {
    pub id Int
    pub name String
    pub extra Bool
}

fn mk() -> User {
    User { id: 1, name: "a", nick: None }
}

fn spread(u: User, b: Big) -> Summary {
    let s = Summary { ..u }
    let t = Summary { ..b, name: "x" }
    let x = Summary { id: 1 } //~ ERROR missing field `name` in `Summary` literal
    let y = Summary { id: 1, name: "a", nme: "b" } //~ ERROR `Summary` has no field `nme`
    let z = Summary { id: 1, id: 2, name: "a" } //~ ERROR field `id` is given twice
    let w = Summary { id: "s", name: "a" } //~ ERROR expected `Int`, found `String`
    let v = Summary { .."s" } //~ ERROR cannot spread a value of type `String`
    let q = u.id //~ TYPE q : Int
    let r = u.nick //~ TYPE r : String?
    let e = u.missing //~ ERROR `User` has no field or method `missing`
    s
}

type Shape = Circle(r: Float) | Square

fn shapes() -> Shape {
    let c = Circle(1.0)
    let s = Square
    let t = Square() //~ ERROR `Square` has no payload
    let u = Circle() //~ ERROR `Circle` takes 1 payload value, 0 given
    let v = Circle //~ ERROR `Circle` needs a payload
    let w = Shape { r: 1.0 } //~ ERROR `Shape` is a type
    let a = User(1) //~ ERROR `User` is a type, not a value
    let q = Shape.Circle(2.0) //~ TYPE q : Shape
    c
}
