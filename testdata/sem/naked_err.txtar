-- app/t/t.kg --
extern(C, naked) { //~ ERROR `naked` belongs to `export` blocks
    fn getpid() -> i32
}

export(C, naked) {
    pub fn start() -> Never {
        asm {
            "ud2"
        }
    }
    pub pure fn twice(x: i64) -> i64 { //~ ERROR naked functions cannot be `pure`
        asm {
            "lea rax, [rdi + rdi]"
            "ret"
        }
    }
    pub fn bad(x: i64) -> i64 { //~ ERROR a naked function's body is one `asm { }` block and nothing else
        let y = x
        asm {
            "ret"
        }
    }
    pub fn kg_export_x() -> i64 { //~ ERROR `kg_export_x`: names starting with `kg_export_`, `kg_byval_` or `kg_call_` are reserved for generated C symbols
        asm {
            "ret"
        }
    }
    pub fn args(x: i64) -> i64 {
        asm {
            "mov rax, {x}"
            "ret"
            x: in(rdi) x //~ ERROR naked asm takes only `const` and `sym` operands
        }
    }
}

type Foo = {
    pub v i64
}

export(C, naked) {
    pub fn Foo.addSelf(self, b: i64) -> i64 { //~ ERROR naked functions cannot be methods
        asm {
            "ret"
        }
    }
}

fn use() -> i64 {
    let a = twice(1) //~ ERROR calling `twice` requires an `unsafe { }` block
    let f: extern(C) fn(i64) -> i64 = twice
    let g: fn(i64) -> i64 = twice //~ ERROR expected `fn(Int) -> Int`, found `extern(C) fn(Int) -> Int`
    a + unsafe { f(2) }
}

