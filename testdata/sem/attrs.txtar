-- app/web/w.kg --
pub type Metadata = {
    tag String
}

/// Marks a controller with its route prefix.
pub pure fn controller(prefix: String) -> Metadata {
    Metadata { tag: prefix }
}

pub pure fn get(path: String) -> Metadata {
    Metadata { tag: path }
}

pub pure fn param(name: String) -> Metadata {
    Metadata { tag: name }
}

pub fn notSchema(x: Int) -> Int {
    x
}
-- app/t/t.kg --
import web from app/web

@web.controller("/users")
pub type Users = {
    pub count Int
}

@web.get("/:id")
pub fn Users.show(self, @web.param("id") id: Int) -> Int {
    id
}

@web.controller("/dup")
@web.controller("/dup") //~ ERROR duplicate metadata item `web.controller`
pub type Twice = {
    pub n Int
}

@web.notSchema(1) //~ ERROR `web.notSchema` is not a metadata schema (a function returning `Metadata`)
pub const A: Int = 1

@bogus //~ ERROR unknown attribute `@bogus`
pub const B: Int = 2

@impl(Display) //~ ERROR `@impl` applies to type declarations only
pub fn plain() -> Int {
    3
}

@web.get(web.notSchema(1)) //~ ERROR
pub fn dyn() -> Int {
    4
}

