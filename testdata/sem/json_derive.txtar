-- app/t/t.kg --
import json from std/json

type Point = {
    pub x Int
    pub y Int
}

type Handler = {
    pub run fn(Int) -> Int
}

type Boxed = {
    pub items Array[Point]
}

pub interface Show {
    fn show(self) -> String
}

pub fn Boxed.show(self) -> String {
    "boxed"
}

pub fn Point.show(self) -> String {
    "point"
}

pub fn Array[T: Show].show(self) -> String {
    "array"
}

fn useIt() -> Unit! {
    let p = Point { x: 1, y: 2 }
    let text = json.encode(p)?
    _ = text
    let back = json.decode[Point]("{}")?
    _ = back
    let h = Handler { run: (n: Int) => n }
    let bad = json.encode(h)? //~ ERROR `Handler` does not satisfy `Encode`
    _ = bad
    let shown: Show = Array.of(p) //~ ERROR `Array[Point]` cannot become a dynamic `Show`
    _ = shown
}

pub fn String.show(self) -> String {
    "text"
}

pub fn i64.trim(self) -> Int { //~ ERROR member functions of `i64` must be declared in package
    self
}
