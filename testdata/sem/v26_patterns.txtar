-- lib/pat.kg --
type Shape = Circle(r: Float) | Dot

type P = {
    pub x Int
}

type TimeoutError = {
    pub url String
}

fn TimeoutError.message(self) -> String {
    self.url
}

fn use(x: Int?, s: Shape, p: P, xs: Array[Int?], e: Error) -> Int {
    let Some(v) = x //~ ERROR refutable pattern needs `else` (`None` is not covered)
    for Some(w) in xs {} //~ ERROR refutable pattern needs `else` (`None` is not covered)
    let P { x: px } = p
    let Circle(r) = s else { return 0 }
    let q = p else { return 1 } //~ WARNING pattern is irrefutable
    let Some(a) = x else { return 2 }
    let b = a + 1 //~ TYPE b : Int
    if e is TimeoutError(t) {
        let u = t.url //~ TYPE u : String
    }
    if e is TimeoutError { return 3 }
    if s is Circle(rr) { return 4 } //~ WARNING `s` is already known to be `Circle`
    px
}
