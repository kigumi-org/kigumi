import json from std/json

type Weird = {
    pub value Option[Option[Int]]
}

type Choice =
    | A(Option[Option[String]])
    | B

fn useIt(text: String) -> Unit! {
    let w = Weird { value: Some(None) }
    let encoded = json.encode(w)? //~ ERROR `Weird` cannot derive JSON `Encode`
    _ = encoded
    let back = json.decode[Choice](text)? //~ ERROR `Choice` cannot derive JSON `Decode`
    _ = back
}
