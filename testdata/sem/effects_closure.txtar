    let h: pure fn(Int) -> Int = double
    let i: pure fn(Int) -> Int = impureDouble //~ ERROR `impureDouble` is not `pure` (contains `unsafe`)
    let mut n = 0
    let inc = () => {
        n += 1
    }
    let j: pure fn() -> Unit = inc //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
    let k = (x: Int) => x + n
    let m: pure fn(Int) -> Int = k //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
}

pure fn callsClosure(x: Int) -> Int {
    let f = (y: Int) => y + 1
    f(x)
}

pure fn callsImpureClosure(x: Int) -> Int {
    let f = (y: Int) => unsafe { y }
    f(x) //~ ERROR `f` is not `pure`
}
