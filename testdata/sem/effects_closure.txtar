import fs from std/fs

fn apply(f: pure fn(Int) -> Int) -> Int {
    f(1)
}

fn double(x: Int) -> Int {
    x * 2
}

fn impureDouble(x: Int) -> Int {
    unsafe { x * 2 }
}

fn use(files: fs.Files, p: fs.Path) -> Unit {
    let a = apply((x) => x + 1)
    let b = apply((x) => { //~ ERROR closure is not `pure` (calls `remove`)
        _ = files.remove(p)
        x
