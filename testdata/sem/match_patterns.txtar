-- lib/pat.kg --
type Shape = Circle(r: Float) | Rect(w: Float, h: Float) | Dot

type P = Pos(Int)

fn area(s: Shape) -> Float {
    match s {
        Circle(r) -> r * r
        Rect(w, h) -> w * h
        Dot -> 0.0
    }
}

fn bad(s: Shape, o: Int?, p: P) -> Int {
    match s {
        Circle(r, x) -> 1 //~ ERROR `Circle` has 1 payload, 2 patterns given
        Rect(w, w) -> 2 //~ ERROR `w` is bound twice in one pattern
        Some(v) -> 3 //~ ERROR `Some` is not a variant of `Shape`
        Nope -> 4 //~ ERROR undefined constructor `Nope`
        Rect { w, h: hh } -> 5 //~ WARNING unreachable pattern
        Circle { r } -> 6
        "s" -> 7 //~ ERROR literal pattern `"s"` does not fit `Shape`
        Rect { nope } -> 8 //~ ERROR `Rect` has no field `nope`
        _ -> 9
    }
    match o {
        Some(1) -> 1
        Some(v) -> v
        None -> 0
    }
    match p {
        Pos { v } -> 1 //~ ERROR `Pos` has positional payload
        Pos(v) -> v
    }
}

fn letpat(o: Int?) -> Int {
    let Some(v) = o else { return 0 }
    let Some(w) = o //~ ERROR refutable pattern needs `else` (`None` is not covered)
    let x = o else { return 1 } //~ WARNING pattern is irrefutable
    let Some(y) = o else { let q = 1 } //~ ERROR `else` block must end with `return`, `fail`, `break`, `continue` or `panic()`
    v
}

fn isExpr(o: Int?, s: Shape) -> Bool {
    if o is Some(v) && v > 0 { return true }
    if s is Rect(w, _) && w > 1.0 { return true }
    let b = s is Dot
    b
}

fn ifLet(o: Int?) -> Int {
    if let n = 3; n > 2 { return n }
    0
}
