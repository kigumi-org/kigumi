-- app/t/t.kg --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    _ = self
}

fn leak(xs: Array[Res]) -> Int {
    let r = xs.with(0, (r) => r) //~ ERROR borrow types cannot appear in return types
    _ = r
    0
}

fn fine(xs: Array[Res]) -> Int {
    xs.with(0, (r) => r.id) || 0
}
