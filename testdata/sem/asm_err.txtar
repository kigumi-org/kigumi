-- app/t/t.kg --
type Pair = {
    pub lo u32
    pub hi u32
}

extern(C) {
    fn puts(s: *const u8) -> i32
}

fn plain(x: i32) -> i32 {
    x
}

fn bad(x: u64, name: String) -> Out[u64] {
    let a = asm { //~ ERROR inline assembly requires an `unsafe { }` block
        "nop"
    }
    unsafe {
        asm { //~ ERROR asm outputs need an expected record type
            "mov {value}, 1"
            value: out(reg)
        }
        asm {
            "mov ${x}, 1" //~ ERROR asm templates take `{name}` operands, not `${}` interpolation
            in(rax) x
        }
        asm { //~ ERROR asm outputs need an expected record type
            "add {v}, 1" //~ ERROR the template names `v`, which is not an operand label
            "x {" //~ ERROR unbalanced `{`
            in(rbx) x //~ ERROR register `rbx` cannot be an operand: rbx is used internally by the code generator
            in(zzz) x //~ ERROR unknown register `zzz` for amd64
            in(eax) x //~ ERROR `u64` does not fit `eax`, which is 32 bits
            in(xmm0) x //~ ERROR `u64` does not fit a floating-point register
            in(reg) name //~ ERROR `String` is not an asm operand type
            in(rcx) //~ ERROR `in` needs a value
            out(rdx) //~ ERROR `out` operands need a label naming a field of the result record
            k: const name //~ ERROR `const` operands take an integer literal or a `const`
            const 4 //~ ERROR `const` operands need a label naming a field of the result record
            "mov {k:zz}, 1" //~ ERROR unknown template modifier `zz` for amd64
            f: sym plain //~ ERROR `sym` names an `extern(C)` declaration or an `export(C)` function
            g: sym puts
            clobber rax, nope //~ ERROR unknown clobber `nope`
            clobber abi(Rust) //~ ERROR unknown ABI `Rust`
            options nomem, bogus //~ ERROR unknown asm option `bogus`
            options nomem, att_syntax //~ ERROR `nomem` is given twice
        }
        asm { //~ ERROR `pure` asm needs an output
            "nop"
            options pure, readonly
        }
        let p: Pair = asm { //~ ERROR asm does not write field `hi` of `Pair`
            "cpuid"
            lo: out(eax)
            lo: out(edx) //~ ERROR label `lo` is used twice
            zz: out(ecx) //~ ERROR `Pair` has no field `zz`
        }
        let sh: Out[u64] = asm { //~ ERROR `pure` needs `nomem` or `readonly`
            "shl {value}, 1"
            value: inout(reg) x
            options pure
        }
        asm { //~ ERROR `noreturn` asm cannot have outputs
            "ud2"
            value: out(rax)
            options noreturn
        }
    }
}

