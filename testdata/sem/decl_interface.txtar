pub interface Display {
    fn display(self) -> String
}

interface Bad {
    fn make() -> Int
    fn body(self) -> Int { //~ ERROR interface requirements cannot have a body
        1
    }
    async fn a(self) -> Int //~ ERROR `async` requirements are not allowed
    pub fn p(self) -> Int //~ WARNING redundant `pub` on an interface requirement
    type T = Int //~ ERROR interface bodies contain only function requirements
}

interface Cl {
    fn dup(self) -> Self
}

fn useCl(c: Cl) -> Unit {} //~ ERROR `Cl` is not object-safe (`Self` appears outside the receiver of `dup`)

fn genericOk[T: Cl](c: T) -> Unit {}

interface Gen {
    fn g[U](self, u: U) -> U
}

fn useGen(g: Gen) -> Unit {} //~ ERROR `Gen` is not object-safe (requirement `g` is generic)

fn selfOut(x: Self) -> Unit {} //~ ERROR `Self` is only available inside an interface body

fn ok(d: Display) -> Display {
    d
}
