-- app/t/t.kg --
type Node = Leaf(Int) | Range(Int) //~ ERROR variant `Range` collides with the prelude type `Range`

type Tree = Twig(Int) | Branch(Int) //~ ERROR variant `Branch` collides with the prelude type `Branch`

type Count = Blank | Int //~ ERROR variant `Int` collides with the predeclared type `Int`

type Proto = Refl | Eq //~ ERROR variant `Eq` collides with the prelude type `Eq`

type Weekday = Mon | Tue | Wed | Thu | Fri | Sat | Sun

type Range = {
    lo Int
    hi Int
}

// Some/None/Ok/Err collide with Option/Result's own variants, which the
// universe scope binds directly (types_predeclared.go declareAdt) unlike
// every other prelude ADT (Ordering, Branch, AllocError below never bind
// their variants to any scope reachable outside std/prelude itself, so a
// same-named variant in another package cannot misresolve the same way).
type MyOption = Some(String) | None //~ ERROR variant `Some` collides with the predeclared variant `Some` //~ ERROR variant `None` collides with the predeclared variant `None`

type MyResult = Ok(Int) | Err(String) //~ ERROR variant `Ok` collides with the predeclared variant `Ok` //~ ERROR variant `Err` collides with the predeclared variant `Err`

// Not a collision: Ordering's Less/Equal/Greater are never bound outside
// std/prelude's own package scope (only Option/Result get that universe
// treatment), so this bare name is unambiguously this file's own variant.
type MyOrdering = Less | Equal | Greater
