-- app/t/t.kg --
type Node[M] = Text(s: String) | Wrap(kid: Node[M])

type Chain = Leaf | Link(next: Chain)

type Mutual = Base | Cont(other: OtherAdt)

type OtherAdt = Stop | Back(m: Mutual)

type Rec = { //~ ERROR `Rec` contains itself without indirection
    next Rec
}

type ThroughAdt = {
    n Node[Int]
}
