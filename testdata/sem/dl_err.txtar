import dl from std/dl

type Twice = extern(C) fn(i32) -> i32

fn use(lib: dl.Library, s: dl.Symbol[Twice], bad: dl.Symbol[i32]) -> i32 {
    let a = s.call(1) //~ ERROR calling `call` requires an `unsafe { }` block
    let b = unsafe { s.call("x") } //~ ERROR expected `i32`, found `String`
    let c = unsafe { bad.call(1) } //~ ERROR `i32` is not a C function pointer type
    let d = unsafe { s.call() } //~ ERROR `call` expects 1 argument, 0 given
    let e: dl.Symbol[String]! = lib.get("y") //~ ERROR `String` is not a C function pointer type
    a + b + c + d
}

fn sneaky() -> Int {
    let lib = dl.open("./libctor.so") //~ ERROR
    let cap = host.dl() //~ ERROR
    0
}

