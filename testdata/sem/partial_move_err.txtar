-- src --
import alloc from std/alloc

type Res = resource {
    pub handle usize
}

fn Res.drop(move self) -> Unit {
    print "drop ${self.handle}"
}

type Holder = { mut r Res }

fn takeField(h: Holder) -> usize {
    move h.r.handle //~ ERROR cannot move `h.r.handle` out of `Res`, which defines a custom `drop`
}

fn takeFromBorrow(h: &Holder) -> Res {
    move h.r //~ ERROR cannot move `Res` out of a borrow
}

fn takeFromIndex(xs: Array[Res]) -> Res {
    move xs[0] //~ ERROR cannot move a value out of an index
}

fn takeFromShared(s: alloc.Shared[Res]) -> Res {
    move s.handle //~ ERROR cannot move a value out of `Shared[Res]`
}

-- expect --
