-- app/t/t.kg --
// `()` is the value of type Unit, the 0-tuple counterpart of `(a, b)`
// (L-112); `Unit` itself stays a type name.
fn takesUnit(u: Unit) -> Unit {
    _ = u
}

fn ok() -> Unit! {
    return Ok(())
}

fn use() -> Unit! {
    let u = () //~ TYPE u : Unit
    takesUnit(u)
    takesUnit(())
    ok()?
}
-- expect --
