-- app/t/t.kg --
const K = 3

type P = {
    a Int
}

fn f(x: Int) -> Int {
    let y = comptime {
        K * 2
    }
    let z = comptime {
        x + 1 //~ ERROR `x` is a runtime value
    }
    let p = comptime { //~ ERROR a comptime block must produce a number, Bool, Char, String or Bytes, not `P`
        P { a: 1 }
    }
    y + z + p.a
}

