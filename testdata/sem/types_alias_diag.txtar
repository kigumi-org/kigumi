fn useMatch(c: Choice) -> Unit {
    let id: UserId = match c {
        A -> "bad" //~ ERROR expected `UserId`, found `String`
        B -> "still bad" //~ ERROR expected `UserId`, found `String`
    }
}

fn useBlock() -> Unit {
