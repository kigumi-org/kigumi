-- lib/pat.kg --
type Shape = Circle(r: Int) | Square(s: Int)

fn okNoElse(x: Int?) -> Unit {
    if let Some(v) = x {
        let w = v //~ TYPE w : Int
    }
}

fn okElse(x: Shape) -> Int {
    if let Circle(r) = x {
        r
    } else {
        0
    }
}

fn badLiteral(x: Shape) -> Int {
    if let Circle("x") = x { //~ ERROR literal pattern `"x"` does not fit `Int`
        1
    } else {
        0
    }
}
