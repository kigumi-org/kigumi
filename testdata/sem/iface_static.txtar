-- lib/s.kg --
pub interface Parse {
    fn parse(text: String) -> Self?
}

pub interface Show {
    fn show(self) -> String
}

pub type Num = {
    pub n Int
}

pub fn Num.parse(text: String) -> Num? {
    Some(Num { n: 1 })
}

pub fn Num.show(self) -> String {
    "${self.n}"
}

pub type Bad = {
    pub n Int
}

pub fn Bad.parse(self) -> Bad? {
    Some(self)
}

pub fn parseAll[T: Parse](texts: Array[String]) -> Array[T] {
    let mut out = Array.empty[T]()
    for t in texts {
        if T.parse(t) is Some(v) {
            out.push(v)
        }
    }
    out
}

pub fn showAll[T: Show](xs: Array[T]) -> Array[String] {
    let mut out = Array.empty[String]()
    for x in xs {
        out.push(x.show())
    }
    out
}

pub fn useIt() -> Unit {
    let nums = parseAll[Num](Array.of("1", "2"))
    _ = showAll(nums)
    let bad = parseAll[Bad](Array.of("x")) //~ ERROR `Bad` does not satisfy `Parse`
    _ = bad
    let boxed: Parse = Num { n: 1 } //~ ERROR `Parse` is not object-safe
    _ = boxed
}

pub fn wrong[T](x: T) -> Unit {
    let v = T.parse("x") //~ ERROR `T` has no method `parse`
    _ = v
}
