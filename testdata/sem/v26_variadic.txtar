    let w = a + 1
    w(...xs) //~ ERROR `Int` is not callable
    cmd(...xs) //~ ERROR no overload of `cmd` takes (Array[String])
    fixed(...xs) //~ ERROR `fixed` is not variadic
    fixed("a", "b") //~ ERROR `fixed` expects 1 argument, 2 given
}
