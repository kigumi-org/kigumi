type Res[T] = Result[T, Error]

type Pair[A, B] = Array[Result[A, B]]

pub type Id = Int

fn ok(x: Int) -> Res[Int] {
    Ok(x)
}

fn take(p: Pair[Int, Error]) -> usize {
    p.len()
}

fn use1() -> Int! {
    let r: Res[Int] = ok(1)
    let v = r?
    v
}

