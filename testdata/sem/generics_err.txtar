-- lib/gen.kg --
interface Show {
    fn show(self) -> String
}

type P = {
    pub x Int
}

type Wrap[T: Eq] = {
    pub v T
}

fn same[T: Eq](a: T, b: T) -> Bool {
    a == b
}

fn bad[T](a: T, b: T) -> Bool {
    a == b //~ ERROR `==` is not defined for `T` (no `Eq`)
}

fn call[F: Fn[fn(Int) -> Int]](f: F) -> Int {
    f(1)
}

fn callBad[F: Fn[fn(Int) -> Int]](f: F) -> String {
    f(1) //~ ERROR expected `String`, found `Int`
}

fn showIt[T: Show](x: T) -> String {
    x.show()
}

fn noShow[T](x: T) -> String {
    x.show() //~ ERROR `T` has no method `show`
}

fn use(p: P, f: fn() -> Unit) -> Unit {
    let mut n = 0
    call(() => 1) //~ ERROR lambda takes 0 parameters, `fn(Int) -> Int` expects 1 //~ WARNING unused value of type `Int`
    call((x) => { //~ WARNING unused value of type `Int` //~ ERROR does not satisfy `Fn[fn(Int) -> Int]`: the closure assigns `n`
        n += 1
        x
    })
    showIt(1) //~ ERROR `Int` does not satisfy `Show` //~ WARNING unused value of type `String`
    showIt(p) //~ ERROR `P` does not satisfy `Show` //~ WARNING unused value of type `String`
    let x = Wrap { v: f } //~ ERROR `fn() -> Unit` does not satisfy `Eq`
    let y = same(1, "s") //~ ERROR expected `Int`, found `String`
    let z = showIt[Int, Int](1) //~ ERROR `showIt` takes 1 type argument, 2 given
}
