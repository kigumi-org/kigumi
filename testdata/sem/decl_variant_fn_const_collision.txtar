// An overload set collides the same way a single fn does, since both bind
// Set != 0 in the package scope.
fn Greet(x: Int) -> Int { x }
fn Greet(x: Int, y: Int) -> Int { x + y }

type Hello = Greet(Int) | Bye //~ ERROR variant `Greet` collides with the declared function `Greet`

// Not a collision: two ADTs of the same package sharing a variant name is
// the existing variant-ambiguity rule (r.variantNames), unrelated to this
// check.
type Shape = Spin(Int) | Square(Int)
type Sign = Spin(Int) | Triangle(Int)
