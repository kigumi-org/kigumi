fn apply(f: fn(Int) -> Int, x: Int) -> Int {
    f(x)
}

fn use(r: &Int) -> Unit {
    let a = (x) => x //~ ERROR parameter `x` needs a type annotation
    apply((x, y) => x, 1) //~ ERROR lambda takes 2 parameters, `fn(Int) -> Int` expects 1 //~ WARNING unused value of type `Int`
    apply((x: String) => 1, 1) //~ ERROR parameter `x` is `String`, expected `Int` //~ WARNING unused value of type `Int`
    apply((x) => "s", 1) //~ ERROR expected `Int`, found `String` //~ WARNING unused value of type `Int`
    let mut n = 0
    let f: fn() -> Unit = () => { //~ ERROR closure captures `n` (assigned inside the closure) and cannot be a plain `fn`
        n += 1
    }
    let g = () => r //~ ERROR closure cannot capture the borrow `r`
    let h = () => {
        break //~ ERROR `break` outside a loop
    }
    let t = () => {
        let v: Int! = Ok(1)
        v? //~ ERROR `?` in a lambda needs a known return type
    }
    let q = ((x: Int) => x)("s") //~ ERROR expected `Int`, found `String`
    let dup = (x: Int, x: Int) => x //~ ERROR duplicate parameter `x`
    let s: String = (x: Int) => x //~ ERROR expected `String`, found `closure fn(Int) -> Int`
}
