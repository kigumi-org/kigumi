    let e = find(1) || (e) => "s" //~ ERROR expected `Int`, found `String`
    let f = flag() || true //~ WARNING `Option[Bool] ||`: `Some(false)` is a hit
    let g = find(1) || fail 1 //~ ERROR `fail` requires a `Result` return type
    let h = find(1)? //~ ERROR `?` needs a `Result`
    a
}
