-- app/t/t.kg --
extern(C) {
    fn strlen(s: *const u8) -> usize
    fn apply(f: extern(C) fn(i32) -> i32, x: i32) -> i32
    fn bad(f: extern(Rust) fn(i32) -> i32) -> i32 //~ ERROR unknown ABI `Rust`
    fn bad2(f: extern(C) pure fn(i32) -> i32) -> i32 //~ ERROR a C function pointer type takes no `pure` modifier
    fn bad3(f: extern(C) fn(String) -> i32) -> i32 //~ ERROR `String` cannot cross the C ABI
}

export(C) {
    pub fn twice(x: i32) -> i32 {
        x * 2
    }
}

fn plain(x: i32) -> i32 {
    x + 1
}

fn use() -> i32 {
    let f: extern(C) fn(i32) -> i32 = twice
    let g: extern(C) fn(i32) -> i32 = plain //~ ERROR only `extern(C)` declarations and `export(C)` functions convert to `extern(C) fn(i32) -> i32`
    let h: fn(*const u8) -> usize = strlen //~ ERROR expected `fn(*const u8) -> usize`, found `extern(C) fn(*const u8) -> usize`
    let n = f(1) //~ ERROR calling a C function pointer requires an `unsafe { }` block
    let m = unsafe { f(2) }
    let k = unsafe { apply(twice, 3) }
    let bad = unsafe { f("x") } //~ ERROR expected `i32`, found `String`
    n + m + k + bad
}

