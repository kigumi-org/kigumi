fn spin(n: Int) -> Never {
    let mut i = n
    for {
        i = i + 1
    }
}

fn pick(n: Int) -> Int {
    if n > 0 {
        return n
    }
    spin(n)
}

fn stops() -> Int {
    for { //~ ERROR expected `Int`, found `Unit`
        break
    }
}

fn nested() -> Never {
    for {
        for {
            break
        }
    }
}

