-- app/t/t.kg --
async fn fetch(x: Int) -> Int {
    x + 1
}

fn apply[A, R](f: fn(A) -> Future[R], a: A) -> Future[R] {
    f(a)
}

fn wrongAnnotation() -> Unit {
    let g: fn(Int) -> Int = fetch //~ ERROR expected `fn(Int) -> Int`, found `fn(Int) -> Future[Int]`
}

fn awaitOutside() -> Unit {
    let f = fetch
    let p = f(1)
    let x = await p //~ ERROR `await` is only allowed inside an `async fn`
}

async fn driver() -> Int {
    let f = fetch
    await apply(f, 1)
}
