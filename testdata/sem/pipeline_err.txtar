-- lib/pipe.kg --
type Options = {
    pub n Int
}

fn convert(s: String, o: Options) -> String {
    s
}

fn two(s: String) -> Unit {}

fn two(n: Int) -> Unit {}

fn use(o: Options, r: &Options) -> Unit {
    "x" |> convert //~ ERROR `convert` expects 2 arguments, 1 given
    "x" |> convert("y", o) //~ ERROR `convert` expects 2 arguments, 3 given
    "x" |> o //~ ERROR `Options` is not callable
    "x" |> 5 //~ ERROR right-hand side of `|>` must be a call, a function name or a lambda
    "x" |> (a, b) => a //~ ERROR lambda takes 2 parameters, `fn(String) -> _` expects 1
    1 |> (v: String) => v //~ ERROR parameter `v` is `String`, expected `Int`
    "x" |> two
    true |> two //~ ERROR no overload of `two` takes (Bool)
    let f = (n: Int) => n
    let z = "x" |> f //~ ERROR expected `Int`, found `String`
    "x" |> convert(o).n //~ ERROR right-hand side of `|>` must be a call, a function name or a lambda
}
