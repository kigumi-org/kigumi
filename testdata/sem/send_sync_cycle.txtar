-- app/t/t.kg --
type A = {
    pub bs Array[B]
    pub f fn(Int) -> Int
}

type B = {
    pub as_ Array[A]
}

type Node = {
    pub children Array[Node]
    pub value Int
}

fn needsSend[T: Send](x: &T) -> Unit {}

fn use(a: A, b: B, node: Node) -> Unit {
    needsSend(&a) //~ ERROR `A` does not satisfy `Send`: it cannot move to another thread
    needsSend(&b) //~ ERROR `B` does not satisfy `Send`: it cannot move to another thread
    needsSend(&node)
}

