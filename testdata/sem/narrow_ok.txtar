        if y is None { return 1 }
    }
    match y { //~ ERROR non-exhaustive match: `None` is not covered
        Some(v) -> v
    }
    let f = () => {
        if y is None { return 0 }
        match y {
            Some(v) -> v
        }
    }
    match y { //~ ERROR non-exhaustive match: `None` is not covered
        Some(v) -> v
    }
    if y is Some(a) {
        let g = () => match y {
            Some(b) -> b
        }
        return g()
    }
    0
}
