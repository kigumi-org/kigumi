-- lib/res.kg --
type ParseError = BadLine(line: Int) | Empty

type Silent = {
    pub code Int
}

fn parse(s: String) -> Result[Int, ParseError] {
    1
}

fn silent() -> Result[Int, Silent] {
    1
}

fn noResult() -> Int {
    fail Empty //~ ERROR `fail` requires a `Result` return type
}

fn noTry() -> Int {
    parse("x")? //~ ERROR `?` requires a `Result` return type
}

fn notResult() -> Unit! {
    let v = 1? //~ ERROR `?` needs a `Result`, found `Int`
}

fn wrongErr() -> Result[Int, Silent] {
    parse("x")? //~ ERROR cannot propagate `ParseError` from a function returning `Result[_, Silent]`
}

fn noMessage() -> Unit! {
    let v = parse("x")? //~ ERROR cannot propagate `ParseError` from a function returning `Result[_, Error]`
}

fn failNoMessage() -> Unit! {
    fail Silent { code: 1 } //~ ERROR `Silent` does not conform to `Error` (no `fn message(self) -> String`)
}

fn failInt() -> Unit! {
    fail 5 //~ ERROR `Int` does not conform to `Error`
}

fn unused() -> Unit! {
    parse("x") //~ ERROR unused `Result[Int, ParseError]`
    _ = parse("y")
    let r = parse("z")
}

fn missing() -> Unit! {
    fail //~ ERROR `return` needs a value of type `Error`
}
