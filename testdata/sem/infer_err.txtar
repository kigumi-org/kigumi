fn identity[T](x: T) -> T {
    x
}

fn pair[T](a: T, b: T) -> Array[T] {
    Array.of(a, b)
}

fn use() -> Unit {
    let e: Array[u8] = pair(1, 300) //~ ERROR `300` does not fit `u8`
    let g = Array.empty() //~ ERROR cannot infer type parameter
    let i = identity[Int, Int](1) //~ ERROR `identity` takes 1 type argument, 2 given
    let j = identity(1, 2) //~ ERROR `identity` expects 1 argument, 2 given
    let k = pair(1, "s") //~ ERROR expected `Int`, found `String`
    let n = 1
    n(2) //~ ERROR `Int` is not callable
    let p = nope() //~ ERROR undefined name `nope`
    let q = Int //~ ERROR `Int` is a type, not a value
    let r = String.fromBytes("s") //~ ERROR expected `Bytes`, found `String`
}

type Counter = {
    pub mut n Int
}

fn Counter.inc(mut self) -> Unit {
    self.n += 1
}

fn Counter.get(self) -> Int {
    self.n
}

fn Counter.make() -> Counter {
    Counter { n: 0 }
}

fn m() -> Unit {
    let c = Counter.make()
    c.inc() //~ ERROR `inc` takes `mut self` but `c` is immutable
    let mut d = Counter.make()
    Counter.make().inc() //~ ERROR `inc` takes `mut self` but the receiver is a temporary
    Counter.get(d) //~ ERROR `get` is a method
    d.make() //~ ERROR `make` is an associated function
    d.nope() //~ ERROR `Counter` has no field or method `nope`
    c.n = 3 //~ ERROR `c` is immutable
    let s: String = c.get() //~ ERROR expected `String`, found `Int`
    d.inc(1) //~ ERROR `inc` expects 0 arguments, 1 given
    let fld = Counter.n //~ ERROR `n` is a field
}

fn selfUse(c: Counter) -> Unit {
    c.inc() //~ ERROR `inc` takes `mut self` but `c` is immutable
}

fn mutParam(mut c: Counter) -> Unit {
    c.inc()
}

fn Counter.getInc(self) -> Unit {
    self.inc() //~ ERROR `inc` takes `mut self` but `self` is immutable
}
