-- app/t/t.kg --
import {Shared} from std/alloc

type View['a] = { pub data &'a Bytes, pub off usize }

fn pick['a](x: &'a Int, y: &'a Int) -> &Int { //~ ERROR a returned borrow needs a lifetime
    x
}

type Bad = {
    r &Int //~ ERROR a field cannot hold a borrow without a lifetime
}

fn stash['a](b: &'a Bytes) -> Unit {
    let v = View { data: b, off: 0 }
    let s: Shared[View['a]] = Shared.new(v) //~ ERROR carries a borrow and cannot be stored
    _ = s
}

fn escape['a](b: &'a Bytes) -> Unit {
    let v = View { data: b, off: 0 }
    let f = () => v.off //~ ERROR carries a borrow and cannot be stored
    _ = f
}
