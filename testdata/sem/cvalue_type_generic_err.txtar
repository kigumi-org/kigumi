import ffi from std/ffi

fn wrap[U](v: U) -> U {
    let cv = ffi.CValue.new(v) //~ ERROR `U` cannot be a `CValue` element
    cv.get() //~ ERROR `U` cannot be a `CValue` element
}

fn useWrap() -> Unit! {
    let _ = wrap(1)
}

