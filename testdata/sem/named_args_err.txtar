-- app/t/t.kg --
fn greet(name: String, times: Int) -> Unit {}

fn identity(a: Int) -> Int { a }

extern(C) {
    fn printf(fmt: *const u8, ...) -> i32
    fn snprintf(buf: *mut u8, size: usize, fmt: *const u8, ...) -> i32
    fn cstr() -> *const u8
    fn buf() -> *mut u8
}

fn use() -> Unit {
    greet(name: "x", nope: 1) //~ ERROR `greet` has no parameter named `nope`
    greet(name: "x", name: "x") //~ ERROR argument `name` given more than once
    greet(times: 1, "x") //~ ERROR positional argument after a named argument
    let f = identity
    _ = f(a: 1) //~ ERROR a `fn` value has no parameter names
}

fn useCVariadic() -> Unit {
    unsafe {
        _ = printf(fmt: cstr())
        _ = snprintf(fmt: cstr(), size: 10, buf: buf())
        _ = printf(nope: cstr()) //~ ERROR `printf` has no parameter named `nope`
        _ = printf(fmt: cstr(), 1, 2.0) //~ ERROR positional argument after a named argument //~ ERROR positional argument after a named argument
    }
}
