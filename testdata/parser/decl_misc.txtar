-- src --
import json from std/json
import {decode, encode} from std/json
import coreutil from std/shell/coreutil
pub import {User, UserId} from app/model
pub(module) import {decodeInternal} from app/codec
import {
    Map
    Entry
} from std/map
const PI = 3.14159
pub const MAX: u32 = 1 << 20
pub interface Display {
    fn display(self) -> String
}
pub interface Iterator[Item] {
    fn next(mut self) -> Item?
}
pub interface Hash {
    pure noalloc fn hash(self) -> u64
}
test "authorとdayを分解する" {
    let c = parseLine(1, "Alice\t2026-08-01")?
    test.expectEq(c.author, "Alice")?
}
extern(C) {
    type CFile
    fn strlen(text: *const u8) -> usize
    fn printf(format: *const u8, ...) -> i32
}
extern(C, noalloc) {
    fn close(fd: i32) -> i32
}
export(C) {
    pub fn pluginVersion() -> u32 { 1 }
}
export(component) {
    instantiate IntList = List[i64]
}
pub(in app.core) fn helper() -> Unit {}
