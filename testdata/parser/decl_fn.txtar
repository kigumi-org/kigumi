-- src --
/// stable checksum API
pub pure noalloc fn checksum(data: Bytes) -> u64 { data.len() }
noalloc pub pure fn f() -> Unit {}
pure pure fn g() -> Unit {}
pub async fn fetch(net: Network, url: Url) -> Response! { await net.get(url) }
pub unsafe fn readByte(ptr: *const u8) -> u8 { unsafe { mem.read(ptr) } }
fn Vec.length(self) -> Float { self.x }
fn Vec.zero() -> Vec { Vec { x: 0.0 } }
fn ByteBuffer.push(mut self, x: byte) -> Unit { self.data.push(x) }
fn File.drop(move self) -> Unit {}
fn Box[T].value(self) -> T { self.inner }
pub pure fn Array[T].map[U](self, f: fn(T) -> U) -> Array[U] { self.inner }
pub pure fn Vec.+^(a: Vec, b: Vec) -> Vec { a }
pub pure fn Vec.*(a: Float, b: Vec) -> Vec { b }
pub fn fold[A, S](items: list.List[A], initial: S, step: pure fn(S, A) -> S) -> S { initial }
fn applyOnce[A, R, F: FnOnce[fn(A) -> R]](f: F, value: A) -> R { f(value) }
pub fn command(program: String, args: ...String) -> Command { run(program, ...args) }
pub pub(module) fn bad() -> Unit {}
