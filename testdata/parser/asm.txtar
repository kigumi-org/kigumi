-- src --
fn sysWrite(fd: usize, buf: *const u8, len: usize) -> Out[isize] {
    unsafe {
        asm {
            "syscall"
            in(rax) 1
            in(rdi) fd
            in(rsi) buf
            in(rdx) len
            value: out(rax)
            clobber rcx, r11, abi(C)
            options nostack, preserves_flags
        }
    }
}

fn spin(lock: *mut i32) -> Unit {
    unsafe {
        asm {
            "1:"
            "lock bts dword ptr [{l}], 0"
            "jnc 2f"
            "jmp 1b"
            "2:"
            l: in(reg) lock
            n: const 4
            h: sym handler
            eax: inout(eax) 7
            clobber: out(rcx)
        }
    }
}

type asm = {
    x Int
}

fn make() -> asm {
    asm { x: 1 }
}
