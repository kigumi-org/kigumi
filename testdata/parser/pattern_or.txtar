-- src --
fn label(n: Int) -> String {
    match n {
        3 | 6 | 9 -> "fizz"
        5 | 10 -> "buzz"
        _ -> "${n}"
    }
}
fn unpack(s: Shape?) -> Int {
    if s is Some(Rect { w }) { w } else { 0 }
}
