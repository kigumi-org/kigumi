-- src --
fn f() -> Unit! {
    if let n = count(); n > 3 { use(n) }
    if shape is Circle(r) && r > 1.0 { print "big" }
    if x is Some(v) && v > 0 { use(v) }
    let Some(cfg) = load() else { return }
    if x is Some(v) {
        await work()
        use(v)
    }
    if a {
        1
    }
    else if b {
        2
    } else {
        3
    }
    let area = match shape {
        Circle(r) -> 3.14159 * r * r
        Rect(w, h) -> w * h
        Missing(n) if n > 0 -> n
        None -> 0
        _ -> -1
    }
    match cli.parse[Cmd](host.args())? {
        Serve(f) -> serve(host, f)
        Version  -> print cli.versionText()
    }
    for cond { step() }
    for { break }
    let picked = for { break pick() }
    for x in xs { total += x }
    for i in 0..xs.len() { continue }
    let mut f = files.create(path)?
    defer f.close()
    errdefer files.remove(path)
    defer {
        a()
        b()
    }
    let e = parseAll("") || (e) => {
        log(e)
        fail e
    }
    let g = find(id) || return
    if e is notify.TimeoutError { retry() }
    let rep = allocator arena.scope() {
        report.build(parseAll(log)?)
    }
    let allocator = 1
    allocator.foo()
    fail NotFound(path)
    return
}
