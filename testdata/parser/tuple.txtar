-- src --
type Pair = (Int, String)

type Holder = {
    pos (Int, Int)
}

fn two() -> (Int, String) {
    (1, "a")
}

fn addPair(p: (Int, Int)) -> Int {
    let (x, y) = p
    x + y
}

fn use(arr: Array[(Int, String)]) -> Unit {
    for (n, s) in arr {
        _ = n
        _ = s
    }
    let single = (1,)
    match nested() {
        ((a, b), c) -> a + b + c
        (_, _) -> 0
    }
}
