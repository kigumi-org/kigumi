-- src --
type View['a] = { pub data &'a Bytes, pub off usize }
fn head['a](b: &'a Bytes) -> View['a] { b }
fn pick['a](x: &'a mut Int, y: &Int) -> &'a mut Int { x }
fn View['a].first(self) -> &'a u8 { self.data[0] }
