type Res = resource {
    pub id Int
}

type View['a] = { pub data &'a Res, pub off usize }

fn head['a](b: &'a Res) -> View['a] {
    View { data: b, off: 0 }
}

fn mutateWhileViewed(mut buf: Bytes) -> u8 {
    let v = headBytes(&buf)
    buf = Bytes.zeros(8)
    v.data[0]
}

type ViewBytes['a] = { pub data &'a Bytes, pub off usize }

fn headBytes['a](b: &'a Bytes) -> ViewBytes['a] {
    ViewBytes { data: b, off: 0 }
}

fn moveWhileViewed(buf: Res) -> Int {
    let v = head(&buf)
    let taken = buf
    _ = taken
    v.data.id
}

fn identity['a](v: ViewBytes['a]) -> ViewBytes['a] {
    v
}

fn mutateWhileIdentityViewed(mut buf: Bytes) -> u8 {
    let v = identity(headBytes(&buf))
    buf = Bytes.zeros(8)
    v.data[0]
}
