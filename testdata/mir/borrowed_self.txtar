-- lib/self.kg --
type Nat = {
    pub digits Array[Int]
}

fn Nat.shl(self, bits: Int) -> Nat {
    if bits == 0 {
        return self
    }
    Nat { digits: self.digits.clone() }
}

fn Nat.keep(self) -> Nat {
    Nat { digits: self.digits.clone() }
}

type Counter = {
    pub n Int
}

fn Counter.bump(mut self) -> Unit {
    _ = self
}

