-- lib/field.kg --
type Inner = resource {
    pub id Int
}

fn Inner.drop(move self) -> Unit {
    _ = self
}

type Outer = {
    pub inner Inner
    pub n Int
}

type Wrap = {
    pub inner Inner
}

type Box = Wrapped(Inner)

fn record(o: &Outer) -> Wrap {
    Wrap { inner: o.inner }
}

fn variant(o: &Outer) -> Box {
    Wrapped(o.inner)
}

