-- src --
type Item = {
    pub names Array[String]
}

fn twice(items: Array[Item]) -> Unit {
    for it in &items {
        print "${it.names.len()}"
    }
    for it in items {
        print "${it.names.len()}"
    }
}

twice(Array.of(Item { names: Array.of("a") }))
-- expect --
