type Buf = {
    pub mut n Int
}

fn Buf.push(mut self) -> Unit {
    self.n += 1
}

fn Buf.len(self) -> Int {
    self.n
}

fn sharedThenMutate(mut b: Buf) -> Int {
    let r = &b
    b.push()
    r.len()
}

fn exclusiveThenRead(mut b: Buf) -> Int {
    let m = &mut b
    let k = b.len()
    m.push()
    k
}

fn fine(mut b: Buf) -> Int {
    let r = &b
    let n = r.len()
    b.push()
    b.len() + n
}

fn escape(mut b: Buf) -> Unit {
    let r = &b
    let xs = Array.of(r)
}
