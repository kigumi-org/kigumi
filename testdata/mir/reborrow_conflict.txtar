fn inner(out: &mut Array[u8], v: usize) -> Unit {
    if v > 0 { out.push(1) }
}

fn outer() -> Unit {
    let mut xs = Array.empty[u8]()
    let r = &mut xs
    inner(r, xs.len())
}
