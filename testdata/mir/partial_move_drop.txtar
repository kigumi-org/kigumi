-- lib/partial_move_drop.kg --
type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    ()
}

type Pair = { mut a Res, mut b Res }

fn take(mut p: Pair) -> Res {
    let taken = move p.a
    p.a = Res { id: 9 }
    taken
}

fn takeNoReinit(mut p: Pair) -> Res {
    move p.a
}

fn consume(p: Pair) -> Unit {
    ()
}

fn useWhole(mut p: Pair) -> Unit {
    let taken = move p.a
    consume(p)
}

type S = { mut r Res }

fn S.leak(mut self) -> Res {
    move self.r
}
