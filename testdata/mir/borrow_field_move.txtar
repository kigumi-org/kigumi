-- lib/field.kg --
type Inner = resource {
    pub id Int
}

fn Inner.drop(move self) -> Unit {
    _ = self
}

type Outer = {
    pub inner Inner
    pub n Int
}

fn Outer.steal(self) -> Inner {
    self.inner
}

fn Outer.count(self) -> Int {
    self.n
}

fn peek(o: &Outer) -> Int {
    o.inner.id
}

