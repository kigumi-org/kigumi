-- lib/disjoint.kg --
type Pair = {
    mut a Array[u8]
    mut b Array[u8]
}

fn Pair.disjointOk(mut self) -> Unit {
    let r = &mut self.a
    let s = &mut self.b
    r.push(1)
    s.push(2)
}

fn Pair.sameFieldConflict(mut self) -> Unit {
    let r = &mut self.a
    let s = &mut self.a
    r.push(1)
    s.push(2)
}

fn Pair.sharedThenExclusiveConflict(mut self) -> Unit {
    let s = &self.a
    let r = &mut self.a
    s.len()
    r.push(1)
}

type Nested = {
    mut pair Pair
}

fn Nested.nestedOverlapConflict(mut self) -> Unit {
    let r = &mut self.pair.a
    let s = &mut self.pair
    r.push(1)
    s.a.push(2)
}

fn Nested.sharedAncestorThenExclusiveDescendant(mut self) -> Unit {
    let s = &self.pair
    let r = &mut self.pair.a
    s.a.len()
    r.push(1)
}

fn Nested.nestedSiblingsOk(mut self) -> Unit {
    let r = &mut self.pair.a
    let s = &mut self.pair.b
    r.push(1)
    s.push(2)
}

type Bag = {
    mut items Array[Array[u8]]
    mut label Array[u8]
}

fn Bag.indexStaysConservative(mut self) -> Unit {
    let r = &mut self.items[0]
    self.label.push(1)
    r.push(2)
}
