-- lib/reborrow.kg --
fn combine(a: &mut Array[u8], b: &mut Array[u8]) -> Unit {
    a.push(1)
    b.push(2)
}

fn outer(out: &mut Array[u8]) -> Unit {
    combine(out, out)
}
