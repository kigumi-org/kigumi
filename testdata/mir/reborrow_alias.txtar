    drop(%t4)
    %t5 = const 2: u8
    %t6 = borrow 1(%b)
    %t7 = call push(%t6, %t5)
    return %t7
}
fn lib.outer(%out: &mut Array[u8]) -> Unit {
  b0:
    %t1 = call combine(%out, %out)
    return %t1
}
