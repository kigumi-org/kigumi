type Point = {
    pub x Int
    pub y Int
}

fn Point.withX(self, x: Int) -> Point {
    Point { ..self, x: x }
}

type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    _ = self
}

type Handle = {
    pub tag Int
    pub res Res
}

fn Handle.retag(self, tag: Int) -> Handle {
    Handle { ..self, tag: tag }
}

