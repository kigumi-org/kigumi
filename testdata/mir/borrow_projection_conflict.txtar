-- lib/conflict.kg --
type Res = resource {
    pub label String
}

fn Res.drop(move self) -> Unit {
    _ = self
}

type Holder = {
    pub mut slot Res?
}

type Full = {
    pub mut slot Res
}

type Outer = {
    pub mut inner Full
}

fn steal(h: &mut Holder) -> String {
    if h.slot is Some(r) {
        h.slot = None
        return r.label
    }
    "none"
}

fn stealOuter(o: &mut Outer) -> String {
    let Full { slot } = o.inner
    o.inner = Full { slot: Res { label: "r" } }
    slot.label
}

fn peek(h: &mut Holder) -> String {
    if h.slot is Some(r) {
        let s = r.label
        h.slot = None
        return s
    }
    "none"
}
