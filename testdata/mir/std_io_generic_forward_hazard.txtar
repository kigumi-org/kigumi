-- lib/hazard.kg --
// Ledger L-08/L-25/L-116: `w: W` is an interface-constrained type
// parameter, so it is affine like any move-only type. Forwarding it into
// io.writeAll twice moves it once and reads it again on the second call,
// which is now a compile-time use-after-move instead of the silent
// per-call copy this fixture used to pin (docs/limitations_v1.md). Moved
// here from testdata/run: the program no longer builds, so it cannot
// stay a run fixture (TestAotCorpus has no way to expect a build
// failure).
import io from std/io

type LogWriter = {
    mut buf Array[u8]
}

fn LogWriter.write(mut self, data: Bytes) -> usize! {
    let mut i: usize = 0
    for i < data.len() {
        self.buf.push(data.get(i) || 0)
        i += 1
    }
    data.len()
}

fn sendTwice[W: io.Writer](mut w: W, a: Bytes, b: Bytes) -> Unit! {
    io.writeAll(w, a)?
    io.writeAll(w, b)?
}
