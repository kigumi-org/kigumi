-- lib/reinit.kg --
type Box = { pub v Array[Int] }

fn make(v: Int) -> Box {
    Box { v: Array.of(v) }
}

fn reinit(x: Int) -> Box {
    let mut b = make(x)
    b = make(x + 1)
    b
}

fn genuine(x: Int) -> Box {
    let b = make(x)
    let c = b
    b
}
