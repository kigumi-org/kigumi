type Box = {
    pub mut h Handle
}

fn consume(x: Handle) -> Unit {
    x.close()
}

fn twiceField(b: Box) -> Unit {
    consume(b.h)
    consume(b.h)
}

fn plainOverwrite(mut b: Box, fresh: Handle) -> Unit {
    b.h = fresh
}

fn onceThenRestored(mut b: Box, fresh: Handle) -> Unit {
    consume(b.h)
    b.h = fresh
    consume(b.h)
}
