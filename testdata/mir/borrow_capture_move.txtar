type Res = resource {
    pub id Int
}

fn Res.drop(move self) -> Unit {
    _ = self
}

fn keep(r: Res) -> Int {
    r.id
}

fn each(xs: &Array[Int], f: fn(&Int) -> Int) -> Int {
    xs.with(0, f) || 0
}

fn moveOut(xs: &Array[Int], r: Res) -> Int {
    each(xs, (x: &Int) => keep(r))
}
