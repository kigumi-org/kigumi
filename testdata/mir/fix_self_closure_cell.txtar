-- src --
type Counter = {
    pub mut n Int
}

fn Counter.bump(mut self) -> Unit {
    let step = () => {
        self.n = self.n + 1
    }
    step()
}

fn Counter.resetDirect(mut self) -> Unit {
    self = Counter { n: 99 }
}

let mut c = Counter { n: 0 }
c.bump()
c.resetDirect()
print "n=${c.n}"
