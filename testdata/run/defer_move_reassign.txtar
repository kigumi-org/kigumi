-- src --
type Handle = resource {
    pub id Int
}

fn Handle.drop(move self) -> Unit {
    print "drop ${self.id}"
}

fn Handle.close(move self) -> Unit {
    print "close ${self.id}"
}

fn main() -> Unit! {
    let mut h = Handle { id: 1 }
    defer { h.close() }
    h = Handle { id: 2 }
}
-- stdout --
drop 1
close 2
drop 2
