-- src --
interface Show {
    fn show(self) -> String
}

interface R[A] {
    fn render(self, x: A) -> String
}

type Wrap = {
    pub v Int
}

fn Wrap.show(self) -> String {
    "${self.v}"
}

type Tag = {
    pub n Int
}

fn Tag.render[T: Show](self, x: T) -> String {
    "Tag(${self.n})=${x.show()}"
}

fn callRender[X: R[Wrap]](x: X, w: Wrap) -> String {
    x.render(w)
}

let t = Tag { n: 3 }
print callRender(t, Wrap { v: 9 })
-- stdout --
Tag(3)=9
