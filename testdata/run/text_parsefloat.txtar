-- src --
import text from std/text

let a = text.parseFloat("3.14") || -1.0
let b = text.parseFloat("-2.5e3") || -1.0
let c = text.parseFloat("0") || -1.0
let d = text.parseFloat("1e400") || -2.0
let e = text.parseFloat("-1e400") || -2.0
let f = text.parseFloat("abc") || -3.0
let g = text.parseFloat("") || -3.0
let h = text.parseFloat("+1") || -3.0
let i = text.parseFloat("1.7976931348623157e308") || -4.0
// L-131: underflow rounds to 0 or a subnormal like Go's strconv.ParseFloat,
// which only reports a range error on overflow.
let j = text.parseFloat("1e-400") || -5.0
let k = text.parseFloat("1e-310") || -5.0
let l = text.parseFloat("5e-324") || -5.0
print "${a} ${b} ${c} ${d} ${e} ${f} ${g} ${h} ${i} ${j} ${k} ${l}"
-- stdout --
3.14 -2500 0 -2 -2 -3 -3 -3 1.7976931348623157e+308 0 1e-310 5e-324
