-- src --
const LIMIT = 10

fn fib(n: Int) -> Int {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

let table = comptime {
    let mut s = ""
    for i in 0..LIMIT {
        s = "${s}${fib(i)} "
    }
    s
}
let n = comptime {
    fib(20)
}
let ready = comptime {
    LIMIT > 5
}
print "${table}| ${n} ${ready}"
