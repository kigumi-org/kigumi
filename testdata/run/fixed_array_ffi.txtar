-- engines --
native
-- src --
import ffi from std/ffi

extern(C) {
    fn memcpy(dst: *mut Block, src: *const Block, n: usize) -> *mut Block
}

type Block layout(C) = {
    pub tag u8
    pub bytes FixedArray[u8, 16]
}

fn fillBytes(seed: u8) -> FixedArray[u8, 16] {
    let mut fa = FixedArray.filled[u8, 16](0)
    let mut i: usize = 0
    for i < 16 {
        let _ = fa.set(i, seed + (i.toU8() || 0))
        i = i + 1
    }
    fa
}

let block = Block { tag: 7, bytes: fillBytes(100) }
print "${ffi.sizeOf(&block)} ${block.tag}"
print "${block.bytes.get(0) || 0} ${block.bytes.get(15) || 0}"

let src = ffi.CValue.new(block)
let dst = ffi.CValue.new(Block { tag: 0, bytes: FixedArray.filled[u8, 16](0) })
unsafe {
    let _ = memcpy(dst.ptr(), ffi.toConst(src.ptr()), ffi.sizeOf(&block))
}
let copied = dst.get()
print "${copied.tag} ${copied.bytes.get(0) || 0} ${copied.bytes.get(15) || 0}"
-- stdout --
17 7
100 115
7 100 115
