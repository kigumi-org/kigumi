-- src --
let a: f32 = 0.1
let b: f32 = 0.2
let one: f32 = 1
let three: f32 = 3
let big: f32 = 16777216
let tiny: f32 = 0.001
let pi: f32 = 3.14159265358979
let d: f64 = 0.1
let e: f64 = 0.2
print "${a + b} ${one / three} ${big + one} ${-a} ${a * b} ${a - b} ${tiny} ${pi}"
print "${d + e} ${a < b} ${a == a}"
let m: f64 = 1234567.5
let k: f64 = 123456.5
let s: f64 = 0.00001
let t: f64 = 0.0001
let z: f64 = 100
print "${m} ${k} ${s} ${t} ${z} ${m * 1000000000000000}"
