-- src --
import map from std/map
import json from std/json

type Step = {
    pos (Int, Int)
}

fn two() -> (Int, String) {
    (1, "a")
}

fn addPair(p: (Int, Int)) -> Int {
    let (x, y) = p
    x + y
}

let (a, b) = two()
print "a=${a} b=${b}"

let s = Step { pos: (3, 4) }
print "sum=${addPair(s.pos)}"

let t1 = (1, 2)
let t2 = (1, 2)
let t3 = (1, 3)
print "eq=${t1 == t2} ne=${t1 == t3} hasheq=${hash(&t1) == hash(&t2)}"

print "dbg=${debug(&t1)}"

let mut m = map.empty[String, (Int, Int)]()
m.set("a", (1, 2))
m.set("b", (3, 4))
print "get=${debug(&(m.get("a") || (0, 0)))}"
match m.get("b") {
    Some((x, y)) -> print "b=${x},${y}"
    None -> print "missing"
}

// A move-only component's ownership follows the tuple, the same as a
// record: consuming a destructured element does not touch the other one.
fn moveOnly() -> (String, Array[Int]) {
    ("hi", Array.of(1, 2, 3))
}

let (ms, marr) = moveOnly()
print "ms=${ms} n=${marr.len()}"

// Eq/Hash/Ord and JSON derive over a record apply to a tuple unchanged.
let encoded = json.encode(t1) || ""
print "json=${encoded}"
let decoded: (Int, Int)! = json.decode(encoded)
match decoded {
    Ok(v) -> print "decoded=${v._0},${v._1}"
    Err(_) -> print "decode failed"
}
-- stdout --
a=1 b=a
sum=7
eq=true ne=false hasheq=true
dbg=Tuple2 { 1, 2 }
get=Tuple2 { 1, 2 }
b=3,4
ms=hi n=3
json=[1,2]
decoded=1,2
