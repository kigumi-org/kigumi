-- src --
// Ledger L-181: `for (k, v) in map` follows the same owned/&/&mut split as
// Array, reading the entries as (K, V) pairs built from Map's keyList and
// valueList in lockstep.
import map from std/map

type Counter = {
    mut n Int
}

fn owned() -> Unit {
    let mut m = map.empty[String, Int]()
    m.set("a", 1)
    m.set("b", 2)
    for (k, v) in m {
        print "owned ${k}=${v}"
    }
}

fn borrowed() -> Unit {
    let mut m = map.empty[String, Int]()
    m.set("a", 1)
    m.set("b", 2)
    for (k, v) in &m {
        print "borrow ${k}=${v}"
    }
    print "size=${m.len()}"
}

fn borrowedMut() -> Unit {
    let mut m = map.empty[String, Counter]()
    m.set("a", Counter { n: 1 })
    m.set("b", Counter { n: 2 })
    for (k, v) in &mut m {
        v.n = v.n + 100
    }
    for (k, v) in &m {
        print "mut ${k}=${v.n}"
    }
}

owned()
borrowed()
borrowedMut()
-- stdout --
owned a=1
owned b=2
borrow a=1
borrow b=2
size=2
mut a=101
mut b=102
