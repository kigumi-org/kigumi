-- src --
type Shape = Circle(r: Float) | Rect(w: Float, h: Float) | Dot

type Point = {
    pub x Int
    pub mut y Int
}

fn area(s: Shape) -> Float {
    match s {
        Circle(r) -> 3.0 * r * r
        Rect { w, h } -> w * h
        Dot -> 0.0
    }
}

fn Point.shifted(self, dx: Int) -> Point {
    Point { x: self.x + dx, y: self.y }
}

fn Point.bump(mut self) -> Unit {
    self.y += 1
}

let shapes = Array.of(Circle(1.0), Rect(2.0, 3.0), Dot)
for s in &shapes {
    print "area=${area(s)}"
}
let mut p = Point { x: 1, y: 2 }
let q = p.shifted(10)
p.bump()
p.bump()
print "p=(${p.x}, ${p.y}) q=(${q.x}, ${q.y})"
let copy = p
p.bump()
print "copy.y=${copy.y} p.y=${p.y}"
if shapes.get(0) is Some(Circle(r)) {
    print "first radius ${r}"
}
let big = Rect(1.0, 1.0) is Rect { w } && w > 0.5
print "big=${big}"
-- stdout --
area=3
area=6
area=0
p=(1, 4) q=(11, 2)
copy.y=4 p.y=5
first radius 1
big=true
