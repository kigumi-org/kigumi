{
    "name": "kigumi",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "pnpm -r run compile",
        "watch": "pnpm --filter kigumi-vscode run watch",
        "package": "pnpm --filter kigumi-vscode run package",
        "fmt": "biome format --write",
        "lint": "biome lint --write",
        "check": "biome check"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.10"
    }
}
